{
  "uid": "pipeline-health",
  "title": "Pipeline health",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Trades and reference messages/s",
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by(topic)(rate(producer_messages_total[2m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Reconnects and send failures",
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "increase(producer_reconnects_total[5m])",
          "refId": "A"
        },
        {
          "expr": "increase(producer_send_errors_total[5m])",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Producer queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "producer_queue_depth",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Kafka lag by Spark query",
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "spark_kafka_offset_lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Redpanda partition count",
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "expr": "sum(redpanda_cluster_partition_count)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "lakehouse-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
