# Local Docker Compose project name. Service variables are added with each service.
COMPOSE_PROJECT_NAME=streaming-lakehouse

# Public market data endpoints and optional local overrides.
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://data-api.binance.vision
SYMBOLS_FILE=./config/symbols.yaml
AGGTRADE_SCHEMA_VERSION=1

# Local-only S3 credentials. Set custom values in the untracked .env if needed.
MINIO_ROOT_USER=lakehouse
MINIO_ROOT_PASSWORD=lakehouse-local-only
SPARK_TRIGGER=10 seconds
MAX_OFFSETS_PER_TRIGGER=30000
POSTGRES_PASSWORD=lakehouse-db-local-only
TRINO_HOST_PORT=18080
